{
  "$comment": [
    "Machine-readable inventory of the control catalog.",
    "",
    "This is the single source that drives three things that would otherwise drift apart:",
    "  1. the catalog sample's page list,",
    "  2. the visual-baseline inventory (which images must exist, per profile/theme/density),",
    "  3. the lifecycle/input/TV-focus test plan.",
    "",
    "Adding a control means adding a case here. Tests in Maui.Tizen.Validation.Tests enforce",
    "that every case is well-formed and that every checked-in baseline maps back to a case."
  ],

  "schemaVersion": 1,

  "interactions": {
    "$comment": "Closed vocabulary; Maui.Tizen.Validation.Tests rejects anything outside it.",
    "allowed": ["tap", "fill", "scroll", "focus", "select", "toggle", "longpress", "swipe", "remote-navigate"]
  },

  "cases": [
    {
      "id": "button-default",
      "control": "Button",
      "category": "core",
      "description": "Default button with text, exercising the primary tap path.",
      "profiles": ["mobile", "tv"],
      "capturesBaseline": true,
      "interactions": ["tap", "focus"],
      "focusable": true
    },
    {
      "id": "label-wrapping",
      "control": "Label",
      "category": "core",
      "description": "Multi-line label validating text measurement and wrapping.",
      "profiles": ["mobile", "tv"],
      "capturesBaseline": true,
      "interactions": [],
      "focusable": false
    },
    {
      "id": "entry-text-input",
      "control": "Entry",
      "category": "input",
      "description": "Single-line entry covering framework fill and native NUI TextField fill.",
      "profiles": ["mobile"],
      "capturesBaseline": true,
      "interactions": ["tap", "fill", "focus"],
      "focusable": true
    },
    {
      "id": "editor-multiline",
      "control": "Editor",
      "category": "input",
      "description": "Multi-line editor covering NUI TextEditor fill.",
      "profiles": ["mobile"],
      "capturesBaseline": true,
      "interactions": ["tap", "fill", "focus"],
      "focusable": true
    },
    {
      "id": "switch-toggle",
      "control": "Switch",
      "category": "input",
      "description": "Toggle state changes and their visual states.",
      "profiles": ["mobile", "tv"],
      "capturesBaseline": true,
      "interactions": ["tap", "toggle", "focus"],
      "focusable": true
    },
    {
      "id": "slider-drag",
      "control": "Slider",
      "category": "input",
      "description": "Value changes via drag, and via remote left/right on TV.",
      "profiles": ["mobile", "tv"],
      "capturesBaseline": true,
      "interactions": ["swipe", "focus", "remote-navigate"],
      "focusable": true
    },
    {
      "id": "collectionview-vertical",
      "control": "CollectionView",
