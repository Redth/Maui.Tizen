<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Minimal Tizen application head for the core vertical slice.

    Like the backend itself this targets ONLY net11.0-tizen11.0 and is gated on the Samsung Tizen
    workload. It cannot be built until Samsung publishes samsung.net.sdk.tizen.manifest-11.0.100 -
    see docs/net11-status.md.
  -->

  <!--
    TizenPackage.props must be imported here, in the PROPS phase.

    Setting IsTizenProject alone is not enough: TargetFramework is derived from it in
    Directory.Build.targets, which is imported far too late for the SDK's target-framework
    inference to see it. Without this import the project evaluates with an EMPTY TargetFramework -
    verified with `dotnet msbuild -getProperty:TargetFramework` - which silently produces no inner
    build at all rather than any error.

    Maui.Tizen.Core imports the same file for the same reason; a regression test in
    tests/UnitTests pins both.
  -->
  <Import Project="$(MSBuildThisFileDirectory)../../eng/targets/TizenPackage.props" />
  <Import Project="$(RepositoryRoot)eng/Maui.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <RootNamespace>Maui.Tizen.Sample</RootNamespace>
    <AssemblyName>Maui.Tizen.Sample</AssemblyName>
    <ApplicationId>org.tizen.example.MauiTizenSample</ApplicationId>
    <ApplicationVersion>1.0.0</ApplicationVersion>

    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>

    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
  </PropertyGroup>


  <ItemGroup>
    <ProjectReference Include="$(RepositoryRoot)src/Maui.Tizen.Core/Maui.Tizen.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <TizenManifestFile Include="Platforms/Tizen/tizen-manifest.xml" />
    <None Include="Platforms/Tizen/tizen-manifest.xml" />
  </ItemGroup>

  <!--
    Single project resources. These exercise the whole build pipeline: the Resizetizer
    processes them through the public external-backend contract, and Maui.Tizen.Build.Tasks
    turns the results into a generated tizen-manifest.xml, res.xml, splash screens and the
    TizenTpkUserIncludeFiles / TizenResource items the Samsung workload packs into the TPK.
  -->
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Consume the build tasks straight out of this repository rather than from a package, so the
    sample always exercises the sources in this tree. A shipping app gets the same props and
    targets automatically from the Maui.Tizen.Build.Tasks package's buildTransitive folder.
  -->
  <PropertyGroup>
    <_MauiTizenBuildTasksAssembly>$(ArtifactsDir)bin/Maui.Tizen.Build.Tasks/$(Configuration)/netstandard2.0/Maui.Tizen.Build.Tasks.dll</_MauiTizenBuildTasksAssembly>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepositoryRoot)src/Maui.Tizen.Build.Tasks/Maui.Tizen.Build.Tasks.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="$(RepositoryRoot)src/Maui.Tizen.Build.Tasks/buildTransitive/Maui.Tizen.Build.Tasks.props" />
  <Import Project="$(RepositoryRoot)src/Maui.Tizen.Build.Tasks/buildTransitive/Maui.Tizen.Build.Tasks.targets" />

</Project>
