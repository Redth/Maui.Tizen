<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Minimal Tizen application head for the core vertical slice.

    Like the backend itself this targets ONLY net11.0-tizen11.0 and is gated on the Samsung Tizen
    workload. It cannot be built until Samsung publishes samsung.net.sdk.tizen.manifest-11.0.100 -
    see docs/net11-status.md.
  -->

  <!--
    TizenPackage.props must be imported here, in the PROPS phase.

    Setting IsTizenProject alone is not enough: TargetFramework is derived from it in
    Directory.Build.targets, which is imported far too late for the SDK's target-framework
    inference to see it. Without this import the project evaluates with an EMPTY TargetFramework -
    verified with `dotnet msbuild -getProperty:TargetFramework` - which silently produces no inner
    build at all rather than any error.

    Maui.Tizen.Core imports the same file for the same reason; a regression test in
    tests/UnitTests pins both.
  -->
  <Import Project="$(MSBuildThisFileDirectory)../../eng/targets/TizenPackage.props" />
  <Import Project="$(RepositoryRoot)eng/Maui.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <RootNamespace>Maui.Tizen.Sample</RootNamespace>
    <AssemblyName>Maui.Tizen.Sample</AssemblyName>
    <ApplicationId>org.tizen.example.MauiTizenSample</ApplicationId>
    <ApplicationVersion>1.0.0</ApplicationVersion>

    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>

    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Nullable>enable</Nullable>

    <!--
      TizenPackage.props defaults EnableDefaultCompileItems to FALSE, because most projects in this
      repository still hold raw imported dotnet/maui sources that do not compile yet and are listed
      as <None> so they stay navigable.

      The sample is not one of those. It is four hand-written files, all of which compile. Without
      this opt-in it evaluated Compile=[] - an application head that built successfully while
      containing no code at all, produced no entry point, and silently proved nothing. Verified with
      `dotnet msbuild -getItem:Compile`, which returned an empty array.

      Default globbing rather than an explicit list, because that is what a real Tizen app head
      does and this project's job is to look like one. The ref-pack sample lane compiles the same
      files from @(MauiTizenSampleCompile); RealSampleCompilesItsOwnSources and
      SampleLaneCompilesExactlyTheRealSamplesSources pin the two sets together so neither can drift.
    -->
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>


  <ItemGroup>
    <ProjectReference Include="$(RepositoryRoot)src/Maui.Tizen.Core/Maui.Tizen.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <TizenManifestFile Include="Platforms/Tizen/tizen-manifest.xml" />
    <None Include="Platforms/Tizen/tizen-manifest.xml" />
  </ItemGroup>

</Project>
