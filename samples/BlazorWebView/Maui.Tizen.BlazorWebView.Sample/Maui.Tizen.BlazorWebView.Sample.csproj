<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Minimal Blazor sample for the standalone Tizen backend.

    IsTizenProject brings in the single repository TFM and the shared Samsung workload gate from
    Directory.Build.targets, so this sample cannot be built until the workload ships. Its host wiring
    (MauiProgram.cs) and its Razor components are compiled by tests/Maui.Tizen.BlazorWebView.Tests in the
    meantime, which is what keeps the registration snippet in docs/blazorwebview.md honest.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTizenProject>true</IsTizenProject>
    <RootNamespace>Maui.Tizen.BlazorWebView.Sample</RootNamespace>
    <IsPackable>false</IsPackable>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ApplicationId>org.tizen.example.mauitizenblazorsample</ApplicationId>
    <ApplicationTitle>Maui.Tizen BlazorWebView Sample</ApplicationTitle>
    <ApplicationVersion>1.0.0</ApplicationVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/Maui.Tizen.BlazorWebView/Maui.Tizen.BlazorWebView.csproj" />
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

  <ItemGroup>
    <None Include="tizen-manifest.xml" />
  </ItemGroup>

  <!--
    NOTE: wwwroot is deliberately NOT listed here.

    An earlier revision carried <None Include="wwwroot/**/*" CopyToOutputDirectory="PreserveNewest" />,
    which was actively misleading: copying files next to the assembly does nothing for a Tizen app,
    because TizenAssetFileProvider reads from the application's resource directory, not the output
    directory. It also could not have worked for _framework/blazor.webview.js, which is not in the
    project at all - it arrives as a StaticWebAsset from Microsoft.AspNetCore.Components.WebView.

    The real path is StaticWebAsset -> MauiAsset -> TizenResource. Maui.Tizen.BlazorWebView performs
    the first hop from its buildTransitive/ targets, which is why this sample needs no asset wiring
    of its own. See docs/blazorwebview.md and tests/Maui.Tizen.BlazorWebView.Tests/AssetPipelineTests.cs.
  -->

</Project>
