<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Wave C: navigation and advanced Controls handlers for Tizen.

    Identity, packing metadata and the IsTizenProject flag come from the shared
    eng/targets/TizenPackage.props, so this project is gated by the repository-wide
    ValidateTizenWorkloadAvailable target in Directory.Build.targets like every other Tizen
    project. It does not define its own gate.

    Unlike the other package projects it DOES compile, because its sources have already been
    reworked to build against public MAUI API. It opts in through an explicit compile list
    (Sources.props) rather than default globbing, so that eng/validation can compile exactly the
    same set of files against a Tizen TFM whose workload actually exists.
  -->

  <Import Project="$(MSBuildThisFileDirectory)../../eng/targets/TizenPackage.props" />

  <PropertyGroup>
    <RootNamespace>Microsoft.Maui.Platforms.Tizen</RootNamespace>
    <Description>Navigation, Shell, CollectionView, toolbar and menu handlers for the Tizen backend of .NET MAUI.</Description>
  </PropertyGroup>

  <Import Project="Sources.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls.Core" />
    <PackageReference Include="Microsoft.Maui.Core" />
    <PackageReference Include="Tizen.UIExtensions.NUI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Maui.Tizen.Core/Maui.Tizen.Core.csproj" />
  </ItemGroup>

</Project>
