<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)../../eng/targets/TizenPackage.props" />
  <Import Project="$(RepositoryRoot)eng/Maui.Tizen.Core.Sources.props" />

  <PropertyGroup>
    <RootNamespace>Microsoft.Maui.Controls</RootNamespace>
    <Description>Tizen platform implementation for .NET MAUI Controls: Shell, CollectionView, shapes, gesture and modal navigation managers, and TizenSpecific platform configuration.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls.Core" />
    <PackageReference Include="Microsoft.Maui.Core" />
    <PackageReference Include="Tizen.UIExtensions.NUI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Maui.Tizen.Core/Maui.Tizen.Core.csproj" />
  </ItemGroup>

  <!--
    The Controls-level shape handlers. Listed explicitly for the same reason as Maui.Tizen.Core:
    the raw dotnet/maui import shares these directories, so a glob would sweep in sources that
    cannot compile from here. See eng/Maui.Tizen.Core.Sources.props.
  -->
  <ItemGroup>
    <Compile Include="@(MauiTizenWaveBControlsCompile)" />
    <None Remove="@(Compile)" />
  </ItemGroup>

</Project>
