<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Compiles explicit shipping sources and exports a public API, so it documents them.

      Must be set BEFORE the import below, which reads it. Setting it after looked identical and
      silently did nothing.
    -->
    <MauiTizenGeneratesDocumentation>true</MauiTizenGeneratesDocumentation>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)../../eng/targets/TizenPackage.props" />

  <PropertyGroup>
    <RootNamespace>Microsoft.Maui.Controls</RootNamespace>
    <Description>Tizen platform implementation for .NET MAUI Controls: Shell, CollectionView, shapes, gesture and modal navigation managers, and TizenSpecific platform configuration.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls.Core" />
    <PackageReference Include="Microsoft.Maui.Core" />
    <PackageReference Include="Tizen.UIExtensions.NUI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Maui.Tizen.Core/Maui.Tizen.Core.csproj" />
  </ItemGroup>

  <!--
    Explicit, like Maui.Tizen.Core: most of this project is still raw imported dotnet/maui source
    that does not compile yet, so default globbing stays off and sources are opted in as they are
    ported.
  -->
  <Import Project="$(RepositoryRoot)eng/Maui.Tizen.Core.Sources.props" />

  <ItemGroup>
    <Compile Include="@(MauiTizenControlsCompile);@(MauiTizenWaveBControlsCompile)" />
    <None Remove="@(Compile)" />
  </ItemGroup>

  <!--
    Same arrangement as Maui.Tizen.Core: TizenPackage.props attaches the INHERITED dotnet/maui
    baselines to every project, which describe a surface this assembly does not export. They are
    detached and replaced with a baseline for the slice actually compiled here.

    The inherited files stay on disk for the not-yet-ported sources and the API-comparison tooling.
    Maui.Tizen.Controls.RefPackCompile enforces the same baseline, which is where it can actually
    run until the Samsung workload ships.
  -->
  <ItemGroup>
    <AdditionalFiles Remove="PublicAPI/net-tizen/PublicAPI.Shipped.txt" />
    <AdditionalFiles Remove="PublicAPI/net-tizen/PublicAPI.Unshipped.txt" />
    <AdditionalFiles Include="PublicAPI/slice/PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI/slice/PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!--
    The PublicApiAnalyzers reference is NOT declared here.

    TizenPackage.props already adds it to every project that imports it, so declaring it again
    produced two PackageReference items for the same package - NU1504 under CI product restore.
    The analyzer is inert until a project supplies AdditionalFiles, which is what the block above
    does; that is the whole opt-in, and no second reference is needed.
  -->

</Project>
