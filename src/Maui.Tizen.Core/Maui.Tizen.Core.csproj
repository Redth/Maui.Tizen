<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)../../eng/targets/TizenPackage.props" />
  <Import Project="$(RepositoryRoot)eng/Maui.props" />
  <Import Project="$(RepositoryRoot)eng/Maui.Tizen.Core.Sources.props" />

  <PropertyGroup>
    <RootNamespace>Microsoft.Maui</RootNamespace>
    <Description>Tizen platform implementation for .NET MAUI core: handlers, platform views, lifecycle, fonts, and image sources.</Description>

    <!--
      Deliberately NOT UseMaui/SingleProject.

      This is a class library that consumes Microsoft.Maui.Core as a NuGet package; it is not an
      application head. Setting UseMaui=true here makes the SDK require the `maui` workload to be
      installed before it will even restore, which fails on any machine that has the .NET SDK but
      not the MAUI workload - CI included - with NETSDK1147 rather than this repository's own
      MAUITIZEN0001. That converts an explanatory external gate into a confusing one, and it hid
      the gate entirely from eng/tests/test-workload-detection.sh.

      UseMaui and SingleProject belong on the application head; see
      samples/Maui.Tizen.Sample/Maui.Tizen.Sample.csproj.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Core" />
    <PackageReference Include="Microsoft.Maui.Graphics" />
    <!-- Apache-2.0, referenced only. See THIRD-PARTY-NOTICES.md. -->
    <PackageReference Include="Tizen.UIExtensions.NUI" />
  </ItemGroup>

  <!--
    The vertical slice that has actually been ported.

    TizenPackage.props leaves EnableDefaultCompileItems off because most of src/Maui.Tizen.Core
    is still raw, unmodified dotnet/maui source that cannot compile from here. Rather than flip
    that globally, this project opts individual files in as they are reworked. The list lives in
    eng/Maui.Tizen.Core.Sources.props so the two host-side verification lanes under tests/ compile
    exactly the same set.

    Files being compiled are removed from the <None> glob TizenPackage.props applies to
    everything-not-yet-ported, so each file appears exactly once.
  -->
  <ItemGroup>
    <Compile Include="@(MauiTizenPortableCompile);@(MauiTizenHandlerCompile);@(MauiTizenPlatformCompile)" />
    <None Remove="@(Compile)" />
  </ItemGroup>

  <!--
    Tizen.UIExtensions.NUI 0.9.2 transitively declares Microsoft.Maui.Graphics 6.0.300-rc.3.1336.
    Refuse to produce a package while that is true; see eng/Maui.props and docs/net11-status.md.
  -->
  <Target Name="BlockPackOnUnshippableUIExtensions" BeforeTargets="GenerateNuspec"
          Condition="'$(TizenUIExtensionsIsShippable)' != 'true'">
    <Error Code="MAUITIZEN0101"
           Text="Refusing to pack $(MSBuildProjectName) against Tizen.UIExtensions.NUI $(TizenUIExtensionsPackageVersion), which transitively declares Microsoft.Maui.Graphics 6.0.300-rc.3.1336. Bump the Tizen.UIExtensions.NUI PackageVersion in Directory.Packages.props once Samsung republishes it, or pass -p:TizenUIExtensionsIsShippable=true if you have verified the resulting dependency graph." />
  </Target>

</Project>
