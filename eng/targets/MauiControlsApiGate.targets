<Project>

  <UsingTask TaskName="MauiTizenInspectMauiControlsApi"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <AssemblyPath ParameterType="System.String" Required="true" />
      <ModalContractsAvailable ParameterType="System.Boolean" Output="true" />
      <LongPressSendApisAvailable ParameterType="System.Boolean" Output="true" />
    </ParameterGroup>
    <Task>
      <Reference Include="$(MSBuildToolsPath)/Sdks/Microsoft.NET.Sdk/tools/net472/System.Collections.Immutable.dll" />
      <Reference Include="$(MSBuildToolsPath)/Sdks/Microsoft.NET.Sdk/tools/net472/System.Reflection.Metadata.dll" />
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Reflection" />
      <Using Namespace="System.Reflection.Metadata" />
      <Using Namespace="System.Reflection.PortableExecutable" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var publicTypes = new HashSet<string>(StringComparer.Ordinal);
        var publicMethods = new Dictionary<string, HashSet<string>>(StringComparer.Ordinal);

        using (var stream = File.OpenRead(AssemblyPath))
        using (var peReader = new PEReader(stream))
        {
            var metadata = peReader.GetMetadataReader();

            foreach (var typeHandle in metadata.TypeDefinitions)
            {
                var type = metadata.GetTypeDefinition(typeHandle);
                var visibility = type.Attributes & TypeAttributes.VisibilityMask;
                if (visibility != TypeAttributes.Public && visibility != TypeAttributes.NestedPublic)
                    continue;

                var typeName = metadata.GetString(type.Name);
                var typeNamespace = metadata.GetString(type.Namespace);
                var fullName = string.IsNullOrEmpty(typeNamespace)
                    ? typeName
                    : typeNamespace + "." + typeName;

                publicTypes.Add(fullName);

                var methods = new HashSet<string>(StringComparer.Ordinal);
                foreach (var methodHandle in type.GetMethods())
                {
                    var method = metadata.GetMethodDefinition(methodHandle);
                    if ((method.Attributes & MethodAttributes.MemberAccessMask) != MethodAttributes.Public ||
                        (method.Attributes & MethodAttributes.Static) != 0)
                    {
                        continue;
                    }

                    var parameterCount = 0;
                    foreach (var parameterHandle in method.GetParameters())
                    {
                        if (metadata.GetParameter(parameterHandle).SequenceNumber > 0)
                            parameterCount++;
                    }

                    methods.Add(metadata.GetString(method.Name) + "#" + parameterCount);
                }

                publicMethods[fullName] = methods;
            }
        }

        ModalContractsAvailable =
            publicTypes.Contains("Microsoft.Maui.Controls.Platform.IModalNavigationPlatform") &&
            publicTypes.Contains("Microsoft.Maui.Controls.Platform.IModalNavigationPlatformFactory") &&
            publicTypes.Contains("Microsoft.Maui.Controls.Platform.IModalNavigationHost");

        HashSet<string> longPressMethods;
        LongPressSendApisAvailable =
            publicMethods.TryGetValue(
                "Microsoft.Maui.Controls.LongPressGestureRecognizer",
                out longPressMethods) &&
            longPressMethods.Contains("SendLongPressed#2") &&
            longPressMethods.Contains("SendLongPressing#3");
      ]]></Code>
    </Task>
  </UsingTask>

  <!--
    Maui.Tizen.Controls exposes typed adapters for public MAUI seams. Do not produce its nuspec
    while the pinned Microsoft.Maui.Controls binary lacks either seam: a package would restore
    successfully but modal navigation or long press would remain disconnected at runtime.

    The verified overrides are intentionally separate. They are escape hatches for validating a
    newly published package before the central pin is advanced, not a substitute for inspection.
  -->
  <Target Name="BlockControlsPackOnUnavailableMauiPublicContracts"
          BeforeTargets="GenerateNuspec"
          Condition="'$(MSBuildProjectName)' == 'Maui.Tizen.Controls'">
    <ItemGroup>
      <_MauiTizenControlsPackageVersion Include="@(PackageVersion)"
                                        Condition="'%(PackageVersion.Identity)' == 'Microsoft.Maui.Controls.Core'" />
    </ItemGroup>

    <PropertyGroup>
      <_MauiTizenGlobalPackagesFolder Condition="'$(NuGetPackageRoot)' != ''">$(NuGetPackageRoot)</_MauiTizenGlobalPackagesFolder>
      <_MauiTizenGlobalPackagesFolder Condition="'$(_MauiTizenGlobalPackagesFolder)' == '' AND '$(NUGET_PACKAGES)' != ''">$(NUGET_PACKAGES)</_MauiTizenGlobalPackagesFolder>
      <_MauiTizenGlobalPackagesFolder Condition="'$(_MauiTizenGlobalPackagesFolder)' == '' AND '$(HOME)' != ''">$(HOME)/.nuget/packages</_MauiTizenGlobalPackagesFolder>
      <_MauiTizenGlobalPackagesFolder Condition="'$(_MauiTizenGlobalPackagesFolder)' == '' AND '$(USERPROFILE)' != ''">$(USERPROFILE)/.nuget/packages</_MauiTizenGlobalPackagesFolder>
      <MauiTizenControlsAssemblyPath Condition="'$(MauiTizenControlsAssemblyPath)' == ''">$([MSBuild]::NormalizePath('$(_MauiTizenGlobalPackagesFolder)', 'microsoft.maui.controls.core', '%(_MauiTizenControlsPackageVersion.Version)', 'lib', '$(DotNetTfm)', 'Microsoft.Maui.Controls.dll'))</MauiTizenControlsAssemblyPath>
    </PropertyGroup>

    <Error Condition="'@(_MauiTizenControlsPackageVersion)' == '' OR !Exists('$(MauiTizenControlsAssemblyPath)')"
           Code="MAUITIZEN0106"
           Text="Cannot inspect Microsoft.Maui.Controls.dll from the pinned Microsoft.Maui.Controls.Core package for Maui.Tizen.Controls packing. Restore the project and verify Directory.Packages.props contains exactly one Microsoft.Maui.Controls.Core version." />

    <MauiTizenInspectMauiControlsApi AssemblyPath="$(MauiTizenControlsAssemblyPath)">
      <Output TaskParameter="ModalContractsAvailable"
              PropertyName="_MauiTizenModalPublicContractsAvailable" />
      <Output TaskParameter="LongPressSendApisAvailable"
              PropertyName="_MauiTizenLongPressSendApisAvailable" />
    </MauiTizenInspectMauiControlsApi>

    <Error Condition="'$(_MauiTizenModalPublicContractsAvailable)' != 'true' AND '$(MauiTizenModalPublicContractsVerifiedAvailable)' != 'true'"
           Code="MAUITIZEN0104"
           Text="Refusing to pack Maui.Tizen.Controls because the pinned Microsoft.Maui.Controls package does not publicly expose IModalNavigationPlatform, IModalNavigationPlatformFactory, and IModalNavigationHost. Keep the typed provisional adapter, publish/adopt dotnet/maui#37853, then update the package pin; use -p:MauiTizenModalPublicContractsVerifiedAvailable=true only after independently verifying the referenced binary." />

    <Error Condition="'$(_MauiTizenLongPressSendApisAvailable)' != 'true' AND '$(MauiTizenLongPressSendApisVerifiedAvailable)' != 'true'"
           Code="MAUITIZEN0105"
           Text="Refusing to pack Maui.Tizen.Controls because LongPressGestureRecognizer.SendLongPressed and SendLongPressing are not both public in the pinned Microsoft.Maui.Controls package. Pin a published package containing dotnet/maui#37861; use -p:MauiTizenLongPressSendApisVerifiedAvailable=true only after independently verifying the referenced binary." />
  </Target>

</Project>
