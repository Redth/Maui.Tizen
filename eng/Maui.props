<Project>

  <!--
    Package versions for Maui.Tizen.

    Values mirror eng/baselines.json. baselines.json is the source of truth; this file is what
    MSBuild actually reads.
  -->

  <PropertyGroup Label="MAUI packages">
    <!--
      baselines.json > source.developmentPackageBaseline.version

      First coherent public-feed MAUI package set for net11. Served by the `dotnet11` source in
      NuGet.config, NOT by nuget.org. Its nuspecRepositoryCommit is 0b3bb76d2d (dotnet/maui#36657),
      which is the required API floor for this repository.

      The frozen source baseline (ee4d06cde6) is LATER than this package, so a newer coherent dev
      build can be dropped in here without touching anything else.
    -->
    <MicrosoftMauiPackageVersion Condition="'$(MicrosoftMauiPackageVersion)' == ''">11.0.0-preview.7.26418.3</MicrosoftMauiPackageVersion>
  </PropertyGroup>

  <PropertyGroup Label="Tizen packages">
    <!--
      baselines.json > target.referencePack

      Samsung.Tizen.Ref.API15 carries ref/net8.0 reference assemblies for the whole of TizenFX,
      including Tizen.NUI. It is what the compile-validation lane
      (tests/Maui.Tizen.Core.RefPackCompile) uses to type-check the platform sources without the
      Samsung workload installed.
    -->
    <TizenReferencePackId Condition="'$(TizenReferencePackId)' == ''">Samsung.Tizen.Ref.API15</TizenReferencePackId>
    <TizenReferencePackVersion Condition="'$(TizenReferencePackVersion)' == ''">15.0.0.19396</TizenReferencePackVersion>

    <!--
      BLOCKER: Tizen.UIExtensions.NUI 0.9.2 MUST NOT SHIP.

      Its nuspec declares Microsoft.Maui.Graphics / Microsoft.Maui.Graphics.Skia 6.0.300-rc.3.1336
      and SkiaSharp.Views 2.88.6, and it only publishes lib/tizen10.0 and lib/net6.0-tizen7.0. Any
      package built on top of it would drag a .NET 6-era MAUI Graphics into a .NET 11 app.

      baselines.json records that a republish is needed "solely to drop its .NET 6-era
      Microsoft.Maui.Graphics dependencies. No API surface change is expected", so this property is
      the single place to bump once that republish lands.
    -->
    <TizenUIExtensionsPackageVersion Condition="'$(TizenUIExtensionsPackageVersion)' == ''">0.9.2</TizenUIExtensionsPackageVersion>
    <TizenUIExtensionsIsShippable Condition="'$(TizenUIExtensionsIsShippable)' == '' AND '$(TizenUIExtensionsPackageVersion)' == '0.9.2'">false</TizenUIExtensionsIsShippable>
    <TizenUIExtensionsIsShippable Condition="'$(TizenUIExtensionsIsShippable)' == ''">true</TizenUIExtensionsIsShippable>
  </PropertyGroup>

  <PropertyGroup Label="Test packages">
    <MicrosoftNETTestSdkVersion Condition="'$(MicrosoftNETTestSdkVersion)' == ''">17.14.1</MicrosoftNETTestSdkVersion>
    <XunitPackageVersion Condition="'$(XunitPackageVersion)' == ''">2.9.3</XunitPackageVersion>
    <XunitRunnerVisualStudioPackageVersion Condition="'$(XunitRunnerVisualStudioPackageVersion)' == ''">3.1.3</XunitRunnerVisualStudioPackageVersion>
  </PropertyGroup>

</Project>
