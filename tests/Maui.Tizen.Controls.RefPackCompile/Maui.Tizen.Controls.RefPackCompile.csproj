<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Controls bridge compile-validation lane.

    Maui.Tizen.Controls targets net11.0-tizen11.0 and cannot be restored until Samsung publishes the
    11.0.100 workload manifest, so this lane type-checks the bridge against the real TizenFX
    reference assemblies on a plain net11.0 host - the same arrangement Core and the sample use.

    It is a separate assembly on purpose. Folding these sources into the Core lane would merge a
    Controls-referencing assembly into one that must never reference Controls, and would hide
    exactly the dependency-direction mistake this layer exists to avoid.
  -->

  <Import Project="$(RepositoryRoot)eng/Maui.props" />
  <Import Project="$(RepositoryRoot)eng/Maui.Tizen.Core.Sources.props" />
  <Import Project="$(RepositoryRoot)eng/Maui.Tizen.WaveC.Sources.props" />

  <PropertyGroup>
    <TargetFramework>$(DotNetTfm)</TargetFramework>
    <IsTizenProject>false</IsTizenProject>

    <!-- The real product assembly name, so the reference graph matches what ships. -->
    <AssemblyName>Maui.Tizen.Controls</AssemblyName>
    <RootNamespace>Microsoft.Maui.Platforms.Tizen.Controls</RootNamespace>

    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <NoWarn>$(NoWarn);CS1591;NU1701</NoWarn>

    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <DefineConstants>$(DefineConstants);TIZEN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Across the assembly boundary, exactly as the shipped package references Core. -->
    <ProjectReference Include="$(RepositoryRoot)tests/Maui.Tizen.Core.RefPackCompile/Maui.Tizen.Core.RefPackCompile.csproj" />
    <ProjectReference Include="$(RepositoryRoot)tests/Maui.Tizen.Essentials.RefPackCompile/Maui.Tizen.Essentials.RefPackCompile.csproj" />

    <!--
      EXACTLY the product's package references, no more.

      This lane previously referenced Microsoft.Maui.Controls - the XAML-inclusive package - while
      the product references Microsoft.Maui.Controls.Core. A broader reference here means the lane
      can compile code the product cannot, which is the one failure mode a verification lane must
      not have: it would report green while the shipping assembly fails to build.
    -->
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Maui.Controls.Core" />
    <PackageReference Include="Microsoft.Maui.Core" />

    <!--
      The product also references Tizen.UIExtensions.NUI, but it cannot be a PackageReference on a
      net11.0 host - it publishes no compatible assets and restore fails with NU1202. The reference
      assemblies come from TizenRefPack.targets via PackageDownload instead, which is the same
      arrangement the Core and sample lanes use, so the compile surface still matches the product.
    -->
  </ItemGroup>

  <!--
    Runs the PublicAPI analyzer over the bridge with its OWN baseline. Maui.Tizen.Controls is a
    shipping assembly with its own public surface, and without this it had no analyzer and no
    baseline at all - so its API could change silently, which is exactly what the analyzer exists
    to prevent for Core.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <AdditionalFiles Include="$(RepositoryRoot)src/Maui.Tizen.Controls/PublicAPI/slice/PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="$(RepositoryRoot)src/Maui.Tizen.Controls/PublicAPI/slice/PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <Import Project="$(RepositoryRoot)eng/targets/TizenRefPack.targets" />

  <ItemGroup>
    <Compile Include="@(MauiTizenControlsCompile);@(MauiTizenWaveBControlsCompile);@(MauiTizenWaveCAdapterCompile);@(MauiTizenWaveCPlatformCompile);@(MauiTizenWaveCCompile)" LinkBase="Controls" />
  </ItemGroup>

</Project>
