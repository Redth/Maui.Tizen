<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Host-side verification lane.

    The product assembly (src/Maui.Tizen.Core) targets net11.0-tizen11.0 and cannot be built or run
    anywhere until Samsung publishes the 11.0.100 workload manifest. This project compiles the SAME
    backend sources against inert stand-ins for Tizen.NUI, on a plain net11.0 host, so the parts of
    the backend that are genuinely platform-independent - mapper registration, DI/handler
    registration, hosting, dispatching, layout z-index ordering, density conversion - are actually
    executed by tests rather than merely asserted in a document.

    Every NUI call site in the backend is wrapped in `#if TIZEN`; TIZEN is NOT defined here, so the
    stand-ins are never called into.
  -->

  <Import Project="$(RepositoryRoot)eng/Maui.props" />
  <Import Project="$(RepositoryRoot)eng/Maui.Tizen.Core.Sources.props" />

  <PropertyGroup>
    <TargetFramework>$(DotNetTfm)</TargetFramework>
    <IsTizenProject>false</IsTizenProject>
    <AssemblyName>Maui.Tizen.Core.UnitTests</AssemblyName>
    <RootNamespace>Microsoft.Maui.Platforms.Tizen.UnitTests</RootNamespace>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Core" />
    <!--
      Controls is referenced ONLY by this test project, to prove that MAUI Controls types resolve
      to this backend's handlers and that Controls' RemapForControls composes with our mappers.
      The product package deliberately does not depend on Controls.
    -->
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="HostStubs/**/*.cs" />
    <Compile Include="@(MauiTizenPortableCompile)" LinkBase="Backend" />
    <Compile Include="@(MauiTizenHandlerCompile)" LinkBase="Backend" />
    <Compile Include="$(MauiTizenCoreDir)Platform/TizenImageLoaderExtensions.cs" LinkBase="Backend" />
    <Compile Include="$(MauiTizenCoreDir)Platform/TizenContentOwnership.cs" LinkBase="WaveB" />
    <Compile Include="$(MauiTizenCoreDir)Platform/TizenRefreshCoordinator.cs" LinkBase="WaveB" />
    <Compile Include="$(MauiTizenCoreDir)Platform/TizenImageReadinessCoordinator.cs" LinkBase="WaveB" />
    <Compile Include="$(MauiTizenCoreDir)Platform/TizenSwipeStructureCoordinator.cs" LinkBase="WaveB" />
    <Compile Include="$(MauiTizenCoreDir)Platform/Tizen/TizenTaskExtensions.cs" LinkBase="WaveB" />
    <Compile Include="$(MauiTizenCoreDir)Platform/Tizen/TizenRefreshStateMachine.cs" LinkBase="WaveB" />
    <Compile Include="@(MauiTizenWaveBHandlerCompile)" LinkBase="WaveB" />
    <Compile Include="@(MauiTizenWaveBControlsCompile)" LinkBase="WaveBControls" />

    <!--
      The Controls bridge. Every NUI call in it is inside `#if TIZEN`, so it compiles against the
      host stubs like the handler sources do - which is what lets the startup integration be
      EXECUTED here rather than only type-checked in the ref-pack lane. Register() having no
      production caller was invisible precisely because nothing executed that path.
    -->
    <Compile Include="@(MauiTizenControlsCompile)" LinkBase="Controls" />
    <Compile Include="*.cs" />
  </ItemGroup>

</Project>
