<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Repository invariant tests.

    These deliberately test the REPOSITORY, not the Tizen backend. Until the Samsung
    .NET 11 workload ships, no Tizen code can be compiled or executed by anyone, so
    backend tests would be untestable theatre.

    What can be tested today is that the migration's own scaffolding is internally
    consistent: that the pinned baselines are well-formed, that the build configuration
    and the baselines agree with each other, and that the provenance and import tooling
    the extraction depends on has not quietly rotted.

    This project targets plain net11.0 - it is a test host, not a Tizen artifact - which
    is why it is exempt from the Tizen workload gate.
  -->

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsTizenProject>false</IsTizenProject>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);NETSDK1057</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />

    <!--
      NOTE: no ExcludeAssets="runtime" on the MSBuild packages. The build task tests
      construct real TaskItems, so Microsoft.Build.Framework has to be present at runtime;
      excluding it produces a FileNotFoundException during xunit's type discovery, which
      surfaces as "no tests found" rather than as an error.
    -->
    <PackageReference Include="Microsoft.Build.Framework" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Maui.Tizen.Build.Tasks\Maui.Tizen.Build.Tasks.csproj" />
  </ItemGroup>

  <!--
    Read the pinned Resizetizer version back out of central package management rather than
    duplicating it, so the generated test projects always restore exactly what the repository
    builds against.
  -->
  <PropertyGroup>
    <_ResizetizerPinnedVersion>@(PackageVersion->WithMetadataValue('Identity', 'Microsoft.Maui.Resizetizer')->'%(Version)')</_ResizetizerPinnedVersion>
    <_WebViewPinnedVersion>@(PackageVersion->WithMetadataValue('Identity', 'Microsoft.AspNetCore.Components.WebView')->'%(Version)')</_WebViewPinnedVersion>
    <_MauiControlsPinnedVersion>@(PackageVersion->WithMetadataValue('Identity', 'Microsoft.Maui.Controls')->'%(Version)')</_MauiControlsPinnedVersion>
  </PropertyGroup>

  <!--
    The MSBuild integration tests import the real buildTransitive files straight out of the
    source tree and generate throwaway projects that reference the Resizetizer package, so
    they need the repository root and the pinned Resizetizer version at runtime.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepositoryRoot</_Parameter1>
      <_Parameter2>$(RepositoryRoot)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>MauiResizetizerPackageVersion</_Parameter1>
      <_Parameter2>$(_ResizetizerPinnedVersion)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PackageVersion</_Parameter1>
      <_Parameter2>$(Version)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>WebViewPackageVersion</_Parameter1>
      <_Parameter2>$(_WebViewPinnedVersion)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>MauiPackageVersion</_Parameter1>
      <_Parameter2>$(_MauiControlsPinnedVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
