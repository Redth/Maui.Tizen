<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline consistency tests for the migration inventory + API baseline tooling
    (eng/tools, eng/manifests, eng/api-baselines). No network access and no Tizen workload:
    schema-validates eng/manifests/source-disposition.json, re-hashes every generated
    artifact against its recorded checksum and against eng/baselines.json, and proves the
    normalized src/**/PublicAPI/net-tizen imports still match those trusted source hashes.
    A stale, overwritten, deleted, added, or path-drifted imported baseline fails here.
  -->

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsTizenProject>false</IsTizenProject>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
