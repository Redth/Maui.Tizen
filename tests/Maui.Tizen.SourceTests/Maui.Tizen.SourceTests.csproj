<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Host-side verification of the migrated Tizen backend sources.

    This project deliberately does NOT target Tizen, and is therefore exempt from the
    workload gate. The backend itself cannot be compiled by anyone until the Samsung
    .NET 11 workload ships, but "cannot compile it" does not have to mean "cannot verify
    it": these tests parse the backend sources with Roslyn and check them against the
    real MAUI assemblies by reflection, so the expectations are derived rather than
    transcribed by hand.

    Complements tests/UnitTests, which guards repository-level invariants. This project
    guards the migrated handler sources themselves.
  -->

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsTizenProject>false</IsTizenProject>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);NETSDK1057</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />

    <!-- Parses the migrated sources. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />

    <!--
      Reflected over to derive the authoritative neutral mapper key sets: the same neutral
      MAUI assemblies the backend will compile against.
    -->
    <PackageReference Include="Microsoft.Maui.Core" />
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

  <ItemGroup Label="Executable slice of the Wave C adapters">
    <!--
      These two adapters are pure Microsoft.Maui.Controls code with no Tizen.NUI dependency, so
      unlike the rest of Wave C they can be COMPILED AND EXECUTED on a plain net11.0 host.

      That matters: flyout template resolution is where a real regression was found (a pre-resolved
      template owner reaching IShellController and silently selecting the wrong BindableProperty).
      Source analysis cannot catch that class of bug - only running the algorithm can. Everything
      else in Wave C touches NUI and stays source-verified plus API15 type-checked.

      Compiled by link rather than via ProjectReference because the Wave C project targets
      the Tizen framework and cannot be restored until the Samsung workload ships.
    -->
    <Compile Include="$(RepositoryRoot)src/Maui.Tizen.Controls.Navigation/Platform/Toolbar/ToolbarOwnership.cs"
             LinkBase="WaveCAdapters" />
    <Compile Include="$(RepositoryRoot)src/Maui.Tizen.Controls.Navigation/Adapters/ShellElementTree.cs"
             LinkBase="WaveCAdapters" />
    <Compile Include="$(RepositoryRoot)src/Maui.Tizen.Controls.Navigation/Adapters/ShellTemplateResolver.cs"
             LinkBase="WaveCAdapters" />
    <Compile Include="$(RepositoryRoot)src/Maui.Tizen.Controls.Navigation/Adapters/ShellFlyoutTemplateResolution.cs"
             LinkBase="WaveCAdapters" />
  </ItemGroup>

</Project>
