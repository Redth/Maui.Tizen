<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Host-side verification of the migrated Tizen backend sources.

    This project deliberately does NOT target Tizen, and is therefore exempt from the
    workload gate. The backend itself cannot be compiled by anyone until the Samsung
    .NET 11 workload ships, but "cannot compile it" does not have to mean "cannot verify
    it": these tests parse the backend sources with Roslyn and check them against the
    real MAUI assemblies by reflection, so the expectations are derived rather than
    transcribed by hand.

    Complements tests/UnitTests, which guards repository-level invariants. This project
    guards the migrated handler sources themselves.
  -->

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsTizenProject>false</IsTizenProject>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);NETSDK1057</NoWarn>
  </PropertyGroup>

  <!--
    Compile the Wave B sources that carry no Tizen.NUI dependency, so their behaviour can be
    executed here instead of only type-checked by the ref-pack lane.
  -->
  <Import Project="$(RepositoryRoot)eng/Maui.Tizen.Core.Sources.props" />

  <ItemGroup>
    <Compile Include="@(MauiTizenWaveBPortableCompile)" LinkBase="WaveB" />

    <!--
      The Tizen-typed image source contract is NUI-free and is compiled as-is. The concrete
      TizenImageSource is not: it wraps Tizen.NUI.ImageUrl, so HostStubs supplies a payload
      stand-in, exactly as tests/Maui.Tizen.Core.UnitTests does for the platform views.
    -->
    <Compile Include="$(MauiTizenCoreDir)ImageSources/ITizenImageSourceService.cs" LinkBase="WaveB" />

    <!--
      Wave B's URI and font services are free of TizenFX types, so their registration can be
      composed and resolved here. Wave A's file/stream services are not: they call
      Tizen.Applications.ResourceManager, so their half of the composition is only verifiable in
      the ref-pack lane and at integration.
    -->
    <Compile Include="$(MauiTizenCoreDir)ImageSources/TizenWaveBImageSourceServices.cs" LinkBase="WaveB" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />

    <!-- Parses the migrated sources. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />

    <!--
      Reflected over to derive the authoritative neutral mapper key sets: the same neutral
      MAUI assemblies the backend will compile against.
    -->
    <PackageReference Include="Microsoft.Maui.Core" />
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

</Project>
