<Solution>

  <!--
    Maui.Tizen solution.

    Most projects here cannot build until the Samsung .NET 11 workload ships (see
    docs/migration.md). They are still listed so the solution documents the intended
    shape of the repository and so IDE navigation works across the imported sources.

    Maui.Tizen.Build.Tasks is the exception: it targets netstandard2.0, needs no
    workload, and is what the workload-free CI lane actually compiles.
  -->

  <Folder Name="/src/">
    <Project Path="src/Maui.Tizen.Core/Maui.Tizen.Core.csproj" />
    <Project Path="src/Maui.Tizen.Controls/Maui.Tizen.Controls.csproj" />
    <Project Path="src/Maui.Tizen.Essentials/Maui.Tizen.Essentials.csproj" />
    <Project Path="src/Maui.Tizen.BlazorWebView/Maui.Tizen.BlazorWebView.csproj" />
    <Project Path="src/Maui.Tizen.Maps/Maui.Tizen.Maps.csproj" />
    <Project Path="src/Maui.Tizen.Graphics/Maui.Tizen.Graphics.csproj" />
    <Project Path="src/Maui.Tizen.Build.Tasks/Maui.Tizen.Build.Tasks.csproj" />
    <Project Path="src/Maui.Tizen.Templates/Maui.Tizen.Templates.csproj" />
  </Folder>

  <Folder Name="/tests/">
    <Project Path="tests/UnitTests/Maui.Tizen.UnitTests.csproj" />
    <Project Path="eng/tests/PackageGraphProbe/PackageGraphProbe.csproj" />
    <Project Path="eng/tests/PublicApiOptIn/PublicApiOptIn.csproj" />
    <Project Path="eng/tests/PackReadmeProbe/PackReadmeProbe.csproj" />
    <Project Path="eng/tests/Api15CompileProbe/Api15CompileProbe.csproj" />
    <Project Path="tests/TestUtils/Maui.Tizen.TestUtils/Maui.Tizen.TestUtils.csproj" />
    <Project Path="tests/Maui.Tizen.Validation.Tests/Maui.Tizen.Validation.Tests.csproj" />
    <Project Path="tests/Maui.Tizen.Build.Tests/Maui.Tizen.Build.Tests.csproj" />
    <Project Path="tests/Maui.Tizen.Conventions.Tests/Maui.Tizen.Conventions.Tests.csproj" />
    <Project Path="tests/Maui.Tizen.DevFlow.Tests/Maui.Tizen.DevFlow.Tests.csproj" />
    <Project Path="tests/Maui.Tizen.Consumer.Tests/Maui.Tizen.Consumer.Tests.csproj" />
  </Folder>

  <Folder Name="/src/Diagnostics/">
    <!--
      Maui.Tizen.DevFlow.Agent.Shared builds on the host lane. Its Tizen-targeted sibling is
      listed for navigability but cannot be built until the Samsung workload ships.
    -->
    <Project Path="src/Diagnostics/Maui.Tizen.DevFlow.Agent.Shared/Maui.Tizen.DevFlow.Agent.Shared.csproj" />
    <Project Path="src/Diagnostics/Maui.Tizen.DevFlow.Agent/Maui.Tizen.DevFlow.Agent.csproj" />
  </Folder>

  <Folder Name="/eng/">
    <File Path="eng/baselines.json" />
    <File Path="eng/build-workload-free.sh" />
    <File Path="eng/import/tizen-paths.txt" />
    <File Path="eng/import/filter-maui-tizen.sh" />
    <File Path="eng/import/normalize-layout.sh" />
    <File Path="eng/manifests/source-disposition.schema.json" />
    <File Path="eng/targets/TizenPackage.props" />
    <File Path="eng/validation/run-hosted-validation.sh" />
    <File Path="eng/validation/scripts/tizen-device-lane.sh" />
    <File Path="eng/validation/profiles/tizen-profiles.json" />
    <File Path="eng/validation/consumers/sherpa-smoke-contract.json" />
  </Folder>

  <Folder Name="/docs/">
    <File Path="README.md" />
    <File Path="PROVENANCE.md" />
    <File Path="THIRD-PARTY-NOTICES.md" />
    <File Path="docs/architecture.md" />
    <File Path="docs/migration.md" />
  </Folder>

  <Folder Name="/solution items/">
    <File Path="Directory.Build.props" />
    <File Path="Directory.Build.targets" />
    <File Path="Directory.Packages.props" />
    <File Path="global.json" />
    <File Path="nuget.config" />
  </Folder>

</Solution>
