<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      The net11 MAUI packages this repository builds against are not on nuget.org yet.
      Pinned in eng/baselines.json > developmentPackageBaseline.
    -->
    <add key="dotnet11" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet11/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <!--
      Explicit mapping so a prerelease feed cannot shadow a package we expect from
      nuget.org. Without this, a compromised or simply out-of-date prerelease feed can
      silently win resolution for common packages.

      IMPORTANT: the prerelease patterns are listed under BOTH sources on purpose.

      NuGet picks the longest matching pattern and then restores only from sources that
      declare it. If `Microsoft.AspNetCore.*` appeared solely under dotnet11, then every
      ASP.NET Core package - including stable ones - could come only from that feed, and
      anything it happens not to carry fails with NU1100 rather than falling back.
      Declaring the same patterns on both sources keeps both eligible at equal
      specificity, which is what allows the BlazorWebView graph (whose transitive
      Microsoft.AspNetCore.Authorization and Microsoft.JSInterop exist only as prerelease
      on dotnet11) to restore while stable packages still resolve from nuget.org.
    -->
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Microsoft.AspNetCore.*" />
      <package pattern="Microsoft.Extensions.*" />
      <package pattern="Microsoft.JSInterop*" />
    </packageSource>
    <packageSource key="dotnet11">
      <package pattern="Microsoft.Maui.*" />
      <package pattern="Microsoft.AspNetCore.*" />
      <package pattern="Microsoft.Extensions.*" />
      <package pattern="Microsoft.JSInterop*" />
      <package pattern="Microsoft.Dotnet.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
