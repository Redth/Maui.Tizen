<Project>

  <PropertyGroup>
    <!--
      Maui.Tizen targets .NET 11 and newer only. The Tizen platform backend is delivered as a
      standalone package rather than through the in-box dotnet/maui Tizen target frameworks,
      which are disabled on the dotnet/maui net11.0 branch.
    -->
    <MauiTizenDotNetTfm>net11.0</MauiTizenDotNetTfm>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <IsPackable>false</IsPackable>
    <UseArtifactsOutput>true</UseArtifactsOutput>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Maui.Tizen contributors</Authors>
    <PackageProjectUrl>https://github.com/Redth/Maui.Tizen</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Redth/Maui.Tizen</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
